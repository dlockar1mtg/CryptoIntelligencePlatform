.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------
# IDE and operating-system files
# ------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
