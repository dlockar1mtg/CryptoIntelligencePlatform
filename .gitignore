# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
config/local*
config/*secret*
config/*credential*
config/*api_key*
config/*apikey*

# ------------------------------------------------------------
